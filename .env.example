# Database Configuration
DATABASE_HOST=your-rds-endpoint.amazonaws.com
DATABASE_PORT=5432
DATABASE_NAME=webhook_management
DATABASE_USER=webhook_user
DATABASE_PASSWORD_SECRET_ARN=arn:aws:secretsmanager:region:account:secret:name

# Kafka Configuration
KAFKA_BROKERS=broker1:9092,broker2:9092,broker3:9092
KAFKA_CLIENT_ID=webhook-system
KAFKA_TOPIC_EVENTS=webhook-events
KAFKA_TOPIC_RETRY=webhook-events-retry
KAFKA_TOPIC_DLQ=webhook-events-dlq

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# Cognito Configuration
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=your-client-id

# API Gateway
API_GATEWAY_URL=https://api.webhooks.example.com/api/v1

# Application Configuration
NODE_ENV=development
LOG_LEVEL=info
WEBHOOK_TIMEOUT_MS=30000
MAX_RETRIES=3
INITIAL_DELAY_MS=1000

# Secrets Manager
SECRETS_CACHE_TTL=300000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=1000
RATE_LIMIT_TRIGGERS_PER_MINUTE=100

# Frontend Configuration
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,https://app.webhooks.example.com