{
  "name": "event-publisher",
  "version": "1.0.0",
  "description": "Lambda function for event publishing",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && npm run package",
    "package": "cd dist && zip -r ../event-publisher.zip . && cd ..",
    "deploy": "aws lambda update-function-code --function-name event-publisher --zip-file fileb://event-publisher.zip"
  },
  "dependencies": {
    "@aws-sdk/client-glue": "^3.600.0",
    "@aws-sdk/client-secrets-manager": "^3.600.0",
    "ajv": "^8.12.0",
    "kafkajs": "^2.2.4",
    "pg": "^8.12.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.138",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "typescript": "^5.5.3"
  }
}