{
  "name": "webhook-backend",
  "version": "1.0.0",
  "description": "Backend Lambda functions for webhook management system",
  "main": "index.js",
  "scripts": {
    "dev:api": "ts-node local-server.ts",
    "dev:consumer": "ts-node local-consumer.ts",
    "dev:retry": "ts-node local-retry-consumer.ts",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "build": "npm run build:all",
    "build:all": "npm run build:producer && npm run build:schema && npm run build:subscription && npm run build:event && npm run build:delivery && npm run build:retry",
    "build:producer": "cd lambda/producer-onboarding && npm run build",
    "build:schema": "cd lambda/schema-admin && npm run build",
    "build:subscription": "cd lambda/subscription-admin && npm run build",
    "build:event": "cd lambda/event-publisher && npm run build",
    "build:delivery": "cd lambda/delivery-consumer && npm run build",
    "build:retry": "cd lambda/delivery-retry-consumer && npm run build",
    "deploy": "npm run build && node scripts/deploy.js",
    "lint": "eslint . --ext .js,.ts",
    "format": "prettier --write \"**/*.{js,ts,json}\""
  },
  "dependencies": {
    "@aws-sdk/client-glue": "^3.600.0",
    "@aws-sdk/client-secrets-manager": "^3.600.0",
    "@aws-sdk/client-ses": "^3.600.0",
    "@aws-sdk/client-sns": "^3.600.0",
    "ajv": "^8.12.0",
    "ajv-formats": "^3.0.1",
    "axios": "^1.7.2",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "kafkajs": "^2.2.4",
    "pg": "^8.12.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.138",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.2",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  }
}
