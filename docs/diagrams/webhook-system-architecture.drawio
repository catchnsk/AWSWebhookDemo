  <diagram name="1-High-Level-Architecture" id="architecture">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Webhook Management System - High-Level Architecture" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="320" y="20" width="560" height="40" as="geometry" />
        </mxCell>

        <!-- Producers -->
        <mxCell id="producers" value="PRODUCERS&lt;br&gt;(Event Sources)&lt;br&gt;&lt;br&gt;• Order Service&lt;br&gt;• Payment System&lt;br&gt;• User Service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="160" height="140" as="geometry" />
        </mxCell>

        <!-- Subscribers -->
        <mxCell id="subscribers" value="SUBSCRIBERS&lt;br&gt;(Partners)&lt;br&gt;&lt;br&gt;• Shipping API&lt;br&gt;• Analytics SaaS&lt;br&gt;• Email Provider" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1000" y="100" width="160" height="140" as="geometry" />
        </mxCell>

        <!-- API Gateway -->
        <mxCell id="apigateway" value="AWS API GATEWAY&lt;br&gt;(REST API)&lt;br&gt;&lt;br&gt;https://api.webhooks.com/v1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="280" y="120" width="280" height="80" as="geometry" />
        </mxCell>

        <!-- Lambda Functions Container -->
        <mxCell id="lambda-container" value="AWS LAMBDA FUNCTIONS" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="240" y="260" width="560" height="200" as="geometry" />
        </mxCell>

        <!-- Lambda: Producer Onboarding -->
        <mxCell id="lambda-producer" value="Producer&lt;br&gt;Onboarding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="lambda-container">
          <mxGeometry x="20" y="40" width="100" height="60" as="geometry" />
        </mxCell>

        <!-- Lambda: Schema Admin -->
        <mxCell id="lambda-schema" value="Schema&lt;br&gt;Admin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="lambda-container">
          <mxGeometry x="140" y="40" width="100" height="60" as="geometry" />
        </mxCell>

        <!-- Lambda: Subscription Admin -->
        <mxCell id="lambda-subscription" value="Subscription&lt;br&gt;Admin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="lambda-container">
          <mxGeometry x="260" y="40" width="100" height="60" as="geometry" />
        </mxCell>

        <!-- Lambda: Event Publisher -->
        <mxCell id="lambda-event" value="Event&lt;br&gt;Publisher" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="lambda-container">
          <mxGeometry x="380" y="40" width="100" height="60" as="geometry" />
        </mxCell>

        <!-- Lambda: Delivery Consumer -->
        <mxCell id="lambda-delivery" value="Delivery&lt;br&gt;Consumer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="lambda-container">
          <mxGeometry x="140" y="120" width="100" height="60" as="geometry" />
        </mxCell>

        <!-- Lambda: Retry Consumer -->
        <mxCell id="lambda-retry" value="Retry&lt;br&gt;Consumer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="lambda-container">
          <mxGeometry x="260" y="120" width="100" height="60" as="geometry" />
        </mxCell>

        <!-- PostgreSQL Database -->
        <mxCell id="postgres" value="PostgreSQL Database (RDS)&lt;br&gt;&lt;br&gt;• producers&lt;br&gt;• schemas&lt;br&gt;• subscribers&lt;br&gt;• subscriptions&lt;br&gt;• event_messages&lt;br&gt;• delivery_logs" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="340" y="520" width="200" height="140" as="geometry" />
        </mxCell>

        <!-- AWS Glue Schema Registry -->
        <mxCell id="glue" value="AWS Glue&lt;br&gt;Schema Registry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="540" width="120" height="60" as="geometry" />
        </mxCell>

        <!-- Kafka (MSK) -->
        <mxCell id="kafka" value="KAFKA (AWS MSK)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="240" y="720" width="560" height="120" as="geometry" />
        </mxCell>

        <!-- Kafka Topics -->
        <mxCell id="kafka-delivery" value="delivery-messages&lt;br&gt;(3 partitions)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="kafka">
          <mxGeometry x="20" y="40" width="120" height="60" as="geometry" />
        </mxCell>

        <mxCell id="kafka-retry" value="retry-messages&lt;br&gt;(3 partitions)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="kafka">
          <mxGeometry x="160" y="40" width="120" height="60" as="geometry" />
        </mxCell>

        <mxCell id="kafka-dlq" value="dlq-messages&lt;br&gt;(1 partition)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="kafka">
          <mxGeometry x="300" y="40" width="120" height="60" as="geometry" />
        </mxCell>

        <mxCell id="kafka-notif" value="status-notifications&lt;br&gt;(1 partition)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="kafka">
          <mxGeometry x="440" y="40" width="120" height="60" as="geometry" />
        </mxCell>

        <!-- Supporting Services -->
        <mxCell id="services-container" value="SUPPORTING SERVICES" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="840" y="260" width="320" height="400" as="geometry" />
        </mxCell>

        <mxCell id="ses" value="AWS SES&lt;br&gt;(Email)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="services-container">
          <mxGeometry x="20" y="40" width="120" height="60" as="geometry" />
        </mxCell>

        <mxCell id="secrets" value="Secrets Manager" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="services-container">
          <mxGeometry x="160" y="40" width="120" height="60" as="geometry" />
        </mxCell>

        <mxCell id="cloudwatch" value="CloudWatch&lt;br&gt;(Logs/Metrics)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="services-container">
          <mxGeometry x="20" y="120" width="120" height="60" as="geometry" />
        </mxCell>

        <mxCell id="xray" value="X-Ray&lt;br&gt;(Tracing)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="services-container">
          <mxGeometry x="160" y="120" width="120" height="60" as="geometry" />
        </mxCell>

        <mxCell id="egress" value="EGRESS GATEWAY&lt;br&gt;(HTTP Webhook Delivery)&lt;br&gt;&lt;br&gt;• HMAC Signature&lt;br&gt;• Timeout Handling&lt;br&gt;• Circuit Breaker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=top;" vertex="1" parent="services-container">
          <mxGeometry x="20" y="220" width="260" height="120" as="geometry" />
        </mxCell>

        <!-- Arrows: Producers to API Gateway -->
        <mxCell id="arrow1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="producers" target="apigateway">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arrow1-label" value="1. Onboard&lt;br&gt;3. Publish Events" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;" vertex="1" connectable="0" parent="arrow1">
          <mxGeometry x="-0.2" y="2" relative="1" as="geometry">
            <mxPoint x="10" y="-15" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- Arrows: Subscribers to API Gateway -->
        <mxCell id="arrow2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="subscribers" target="apigateway">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arrow2-label" value="2. Subscribe" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;" vertex="1" connectable="0" parent="arrow2">
          <mxGeometry x="-0.2" y="2" relative="1" as="geometry">
            <mxPoint x="-10" y="-12" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- Arrows: API Gateway to Lambda -->
        <mxCell id="arrow3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=2;fontSize=11;dashed=1;" edge="1" parent="1" source="apigateway" target="lambda-container">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Arrows: Lambda to Database -->
        <mxCell id="arrow4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="lambda-container" target="postgres">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Arrows: Schema Lambda to Glue -->
        <mxCell id="arrow5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;fontSize=11;dashed=1;" edge="1" parent="1" source="lambda-schema" target="glue">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Arrows: Event Publisher to Kafka -->
        <mxCell id="arrow6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="lambda-event" target="kafka">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arrow6-label" value="Publish Messages" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;" vertex="1" connectable="0" parent="arrow6">
          <mxGeometry x="-0.2" y="2" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- Arrows: Kafka to Consumers -->
        <mxCell id="arrow7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;fontSize=11;exitX=0.3;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="kafka" target="lambda-delivery">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arrow7-label" value="Consume" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;" vertex="1" connectable="0" parent="arrow7">
          <mxGeometry x="-0.2" y="2" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <mxCell id="arrow8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="kafka" target="lambda-retry">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Arrows: Consumers to Egress Gateway -->
        <mxCell id="arrow9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="lambda-delivery" target="egress">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Arrows: Egress to Subscribers -->
        <mxCell id="arrow10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;fontSize=11;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="egress" target="subscribers">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arrow10-label" value="4. Receive Webhooks&lt;br&gt;(HTTPS POST)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;" vertex="1" connectable="0" parent="arrow10">
          <mxGeometry x="-0.2" y="2" relative="1" as="geometry">
            <mxPoint x="60" as="offset" />
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="2-Data-Flow" id="dataflow">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title2" value="Event Publishing &amp; Delivery Flow" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="320" y="20" width="560" height="40" as="geometry" />
        </mxCell>

        <!-- Step 1: Publish Event -->
        <mxCell id="step1" value="STEP 1: PUBLISH EVENT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;align=center;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="80" y="100" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="step1-text" value="Producer sends:&lt;br&gt;POST /api/v1/events/publish&lt;br&gt;{&lt;br&gt;  &quot;eventType&quot;: &quot;order.created&quot;,&lt;br&gt;  &quot;payload&quot;: {...}&lt;br&gt;}" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="90" y="140" width="220" height="70" as="geometry" />
        </mxCell>

        <!-- Step 2: Validate Schema -->
        <mxCell id="step2" value="STEP 2: VALIDATE SCHEMA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;align=center;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="360" y="100" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="step2-text" value="• Check event type exists&lt;br&gt;• Validate payload vs schema&lt;br&gt;• AWS Glue Schema Registry&lt;br&gt;• Return validation errors" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="370" y="140" width="220" height="70" as="geometry" />
        </mxCell>

        <!-- Step 3: Get Subscriptions -->
        <mxCell id="step3" value="STEP 3: GET SUBSCRIPTIONS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;align=center;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="640" y="100" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="step3-text" value="SELECT * FROM subscriptions&lt;br&gt;WHERE schema_id = X&lt;br&gt;AND enabled = true&lt;br&gt;AND status = 'active'" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="650" y="140" width="220" height="70" as="geometry" />
        </mxCell>

        <!-- Step 4: Publish to Kafka -->
        <mxCell id="step4" value="STEP 4: PUBLISH TO KAFKA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1;align=center;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="80" y="280" width="240" height="160" as="geometry" />
        </mxCell>
        <mxCell id="step4-text" value="FOR EACH subscription:&lt;br&gt;PUBLISH to 'delivery-messages'&lt;br&gt;{&lt;br&gt;  &quot;deliveryId&quot;: &quot;dlv_xxx&quot;,&lt;br&gt;  &quot;webhookUrl&quot;: &quot;...&quot;,&lt;br&gt;  &quot;webhookSecret&quot;: &quot;...&quot;,&lt;br&gt;  &quot;payload&quot;: {...},&lt;br&gt;  &quot;retryAttempt&quot;: 0&lt;br&gt;}" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="90" y="320" width="220" height="110" as="geometry" />
        </mxCell>

        <!-- Step 5: Consume & Deliver -->
        <mxCell id="step5" value="STEP 5: CONSUME &amp; DELIVER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1;align=center;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="360" y="280" width="240" height="160" as="geometry" />
        </mxCell>
        <mxCell id="step5-text" value="Delivery Consumer:&lt;br&gt;• Consume from Kafka&lt;br&gt;• Update DB (delivering)&lt;br&gt;• Add HMAC signature&lt;br&gt;• POST to webhook URL&lt;br&gt;• Handle response" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="370" y="320" width="220" height="110" as="geometry" />
        </mxCell>

        <!-- Step 6: Success or Retry -->
        <mxCell id="step6" value="STEP 6: SUCCESS OR RETRY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;fontStyle=1;align=center;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="640" y="280" width="240" height="160" as="geometry" />
        </mxCell>
        <mxCell id="step6-text" value="IF success (2xx):&lt;br&gt;• Update DB (success)&lt;br&gt;&lt;br&gt;IF failure (5xx, timeout):&lt;br&gt;• Publish to retry-messages&lt;br&gt;• Calculate nextRetryAt&lt;br&gt;• Update DB (retrying)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="650" y="320" width="220" height="110" as="geometry" />
        </mxCell>

        <!-- Step 7: Retry Processing -->
        <mxCell id="step7" value="STEP 7: RETRY PROCESSING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1;align=center;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="80" y="500" width="380" height="140" as="geometry" />
        </mxCell>
        <mxCell id="step7-text" value="Retry Consumer:&lt;br&gt;• Consume from retry-messages&lt;br&gt;• Check if now &gt;= nextRetryAt&lt;br&gt;• IF within retry limit: Republish to delivery-messages&lt;br&gt;• IF max retries exceeded: Move to DLQ" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="90" y="540" width="360" height="90" as="geometry" />
        </mxCell>

        <!-- Step 8: Dead Letter Queue -->
        <mxCell id="step8" value="STEP 8: DEAD LETTER QUEUE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1;align=center;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="500" y="500" width="380" height="140" as="geometry" />
        </mxCell>
        <mxCell id="step8-text" value="When max retries exceeded:&lt;br&gt;• INSERT into delivery_dlq&lt;br&gt;• UPDATE delivery_log (status: failed)&lt;br&gt;• Send notification to subscriber&lt;br&gt;• Admin can manually retry" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="510" y="540" width="360" height="90" as="geometry" />
        </mxCell>

        <!-- Arrows -->
        <mxCell id="arrow-1-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="step1" target="step2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arrow-2-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="step2" target="step3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arrow-3-4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="step3" target="step4">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="760" y="250" />
              <mxPoint x="200" y="250" />
            </Array>
          </mxGeometry>
        </mxCell>

