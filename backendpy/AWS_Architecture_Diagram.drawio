        <mxCell id="notes-title" value="Architecture Notes" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;fontColor=#D4A017;" vertex="1" parent="1">
